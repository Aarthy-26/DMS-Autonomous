            <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT &#13;&#10;S.FACILITY_ID , &#13;&#10;S.PROCESS_NAME, &#13;&#10;S.LOAD_STATUS ,&#13;&#10;S.CRT_TM,&#13;&#10;I.STATUS , &#13;&#10;I.STORE_DATE &#13;&#10;FROM CIIM.DELTA_STORELOAD_LIST S , &#13;&#10;CIIM.TRANSACTIONAL_INFORMATION I&#13;&#10;WHERE S. PROCESS_NAME = '$$PROCESS_NAME'      AND&#13;&#10;I.ATTR_NAME = '$$ATTR_NAME' AND&#13;&#10;S.FACILITY_ID = I.FACILITY_ID         AND&#13;&#10;I.STORE_DATE &gt; S.CRT_TM               AND&#13;&#10;(&#13;&#10;( S.LOAD_STATUS &lt;&gt; '$$LOAD_STATUS_SUCCESS' AND I.STATUS = '$$STORE_LOAD_STATUS' ) &#13;&#10;OR&#13;&#10;( S.LOAD_STATUS = '$$LOAD_STATUS_SUCCESS' AND I.STATUS != '$$STORE_LOAD_STATUS' )&#13;&#10;OR&#13;&#10;( S.LOAD_STATUS != 'JC' AND I.STATUS != 'G' )&#13;&#10;)&#13;&#10;AND S.CRT_TM = ( SELECT MAX(CRT_TM) &#13;&#10;                 FROM CIIM.DELTA_STORELOAD_LIST I&#13;&#10;                 WHERE I.PROCESS_NAME = '$$PROCESS_NAME'&#13;&#10;                 AND I.FACILITY_ID = S.FACILITY_ID )&#13;&#10;UNION&#13;&#10;SELECT &#13;&#10;S.FACILITY_ID , &#13;&#10;S.PROCESS_NAME, &#13;&#10;S.LOAD_STATUS , &#13;&#10;S.CRT_TM,&#13;&#10;'$$MISSING_STORE_STATUS' , &#13;&#10;NULL &#13;&#10;FROM CIIM.DELTA_STORELOAD_LIST S&#13;&#10;WHERE S. PROCESS_NAME = '$$PROCESS_NAME'  AND&#13;&#10;S.FACILITY_ID NOT IN (&#13;&#10;SELECT FACILITY_ID&#13;&#10;FROM&#13;&#10;CIIM.TRANSACTIONAL_INFORMATION I&#13;&#10;WHERE &#13;&#10;I.ATTR_NAME = '$$ATTR_NAME' AND&#13;&#10;I.STORE_DATE &gt; S.CRT_TM )"/>
